{
  "info": {
    "_postman_id": "b4a1e7f0-5c2a-4e3d-9a1b-caresync000002",
    "name": "CareSync - Functional Acceptance",
    "description": "Sequência executável de testes funcionais. Execute na ordem com Postman Collection Runner ou Newman após docker compose up --build.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [{
    "listen": "prerequest",
    "script": {"type":"text/javascript","exec":[
      "const future = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);",
      "pm.collectionVariables.set('futureDateTime', future.toISOString().replace('Z','').slice(0,19));",
      "pm.collectionVariables.set('testUsername', 'enfermeiro_' + Date.now());"
    ]}
  }],
  "variable": [
    {"key":"baseUrl","value":"http://localhost:8081"},
    {"key":"adminToken","value":""},{"key":"medicoToken","value":""},{"key":"enfermeiroToken","value":""},
    {"key":"paciente1Token","value":""},{"key":"paciente2Token","value":""},{"key":"createdUserId","value":""},
    {"key":"createdConsultaId","value":""},{"key":"futureDateTime","value":""},{"key":"testUsername","value":""}
  ],
  "item": [
    {"name":"01 - Autenticação","item":[
      {"name":"Login Admin","event":[{"listen":"test","script":{"exec":["pm.test('200 e JWT',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().token).to.be.a('string').and.not.empty;});","pm.collectionVariables.set('adminToken',pm.response.json().token);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"username\":\"admin1\",\"password\":\"senha123\"}"},"url":"{{baseUrl}}/auth/login"}},
      {"name":"Login Médico","event":[{"listen":"test","script":{"exec":["pm.test('200 e JWT',()=>pm.response.to.have.status(200));","pm.collectionVariables.set('medicoToken',pm.response.json().token);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"username\":\"medico1\",\"password\":\"senha123\"}"},"url":"{{baseUrl}}/auth/login"}},
      {"name":"Login Enfermeiro","event":[{"listen":"test","script":{"exec":["pm.test('200 e JWT',()=>pm.response.to.have.status(200));","pm.collectionVariables.set('enfermeiroToken',pm.response.json().token);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"username\":\"enfermeiro1\",\"password\":\"senha123\"}"},"url":"{{baseUrl}}/auth/login"}},
      {"name":"Login Paciente 1","event":[{"listen":"test","script":{"exec":["pm.test('200 e JWT',()=>pm.response.to.have.status(200));","pm.collectionVariables.set('paciente1Token',pm.response.json().token);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"username\":\"paciente1\",\"password\":\"senha123\"}"},"url":"{{baseUrl}}/auth/login"}},
      {"name":"Login Paciente 2","event":[{"listen":"test","script":{"exec":["pm.test('200 e JWT',()=>pm.response.to.have.status(200));","pm.collectionVariables.set('paciente2Token',pm.response.json().token);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"username\":\"paciente2\",\"password\":\"senha123\"}"},"url":"{{baseUrl}}/auth/login"}},
      {"name":"Senha inválida","event":[{"listen":"test","script":{"exec":["pm.test('401',()=>pm.response.to.have.status(401));","pm.test('erro seguro',()=>pm.expect(pm.response.json().error).to.eql('Usuário ou senha inválidos'));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"username\":\"medico1\",\"password\":\"incorreta\"}"},"url":"{{baseUrl}}/auth/login"}}
    ]},
    {"name":"02 - Administração","item":[
      {"name":"Criar usuário","event":[{"listen":"test","script":{"exec":["pm.test('201',()=>pm.response.to.have.status(201));","const b=pm.response.json();pm.test('sem senha e role correta',()=>{pm.expect(b.password).to.be.undefined;pm.expect(b.role).to.eql('ENFERMEIRO');});","pm.collectionVariables.set('createdUserId',b.id);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{adminToken}}"}],"body":{"mode":"raw","raw":"{\"username\":\"{{testUsername}}\",\"password\":\"senha123\",\"role\":\"ENFERMEIRO\",\"patientId\":null}"},"url":"{{baseUrl}}/users"}},
      {"name":"Listar usuários","event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));","pm.test('usuário criado presente',()=>pm.expect(pm.response.json().some(u=>String(u.id)===String(pm.collectionVariables.get('createdUserId')))).to.be.true);"]}}],"request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"}],"url":"{{baseUrl}}/users"}},
      {"name":"Médico não administra","event":[{"listen":"test","script":{"exec":["pm.test('403',()=>pm.response.to.have.status(403));"]}}],"request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{medicoToken}}"}],"url":"{{baseUrl}}/users"}}
    ]},
    {"name":"03 - Pacientes e histórico","item":[
      {"name":"Paciente consulta os próprios dados","event":[{"listen":"test","script":{"exec":["pm.test('200 sem erros',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().errors).to.be.undefined;});","pm.test('paciente correto',()=>pm.expect(pm.response.json().data.patient.id).to.eql('1'));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{paciente1Token}}"}],"body":{"mode":"raw","raw":"{\"query\":\"query { patient(id: 1) { id name email } }\"}"},"url":"{{baseUrl}}/graphql"}},
      {"name":"Paciente não acessa outro paciente","event":[{"listen":"test","script":{"exec":["pm.test('GraphQL FORBIDDEN',()=>pm.expect(pm.response.json().errors[0].extensions.classification).to.eql('FORBIDDEN'));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{paciente1Token}}"}],"body":{"mode":"raw","raw":"{\"query\":\"query { patient(id: 2) { id name } }\"}"},"url":"{{baseUrl}}/graphql"}},
      {"name":"Histórico completo pelo médico","event":[{"listen":"test","script":{"exec":["pm.test('200 sem erros',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().errors).to.be.undefined;});","pm.test('possui passado e futuro',()=>pm.expect(pm.response.json().data.consultasDoPaciente.length).to.be.at.least(2));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{medicoToken}}"}],"body":{"mode":"raw","raw":"{\"query\":\"query { consultasDoPaciente(patientId: 1) { id patientId dateTime status } }\"}"},"url":"{{baseUrl}}/graphql"}},
      {"name":"Somente futuras pelo enfermeiro","event":[{"listen":"test","script":{"exec":["const b=pm.response.json();pm.test('200 sem erros',()=>{pm.response.to.have.status(200);pm.expect(b.errors).to.be.undefined;});","pm.test('todas futuras',()=>b.data.consultasFuturasDoPaciente.forEach(c=>pm.expect(new Date(c.dateTime).getTime()).to.be.above(Date.now())));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{enfermeiroToken}}"}],"body":{"mode":"raw","raw":"{\"query\":\"query { consultasFuturasDoPaciente(patientId: 1) { id dateTime status } }\"}"},"url":"{{baseUrl}}/graphql"}}
    ]},
    {"name":"04 - Agendamento","item":[
      {"name":"Enfermeiro agenda","event":[{"listen":"test","script":{"exec":["const b=pm.response.json();pm.test('criada sem erros',()=>{pm.expect(b.errors).to.be.undefined;pm.expect(b.data.agendarConsulta.status).to.eql('SCHEDULED');});","pm.collectionVariables.set('createdConsultaId',b.data.agendarConsulta.id);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{enfermeiroToken}}"}],"body":{"mode":"raw","raw":"{\"query\":\"mutation($input: AgendarConsultaInput!) { agendarConsulta(input: $input) { id patientId status reason } }\",\"variables\":{\"input\":{\"patientId\":1,\"doctorName\":\"Dra. Teste\",\"dateTime\":\"{{futureDateTime}}\",\"reason\":\"Teste funcional\"}}}"},"url":"{{baseUrl}}/graphql"}},
      {"name":"Médico edita","event":[{"listen":"test","script":{"exec":["const b=pm.response.json();pm.test('editada sem erros',()=>{pm.expect(b.errors).to.be.undefined;pm.expect(b.data.editarConsulta.id).to.eql(pm.collectionVariables.get('createdConsultaId'));pm.expect(b.data.editarConsulta.status).to.eql('CANCELLED');});"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{medicoToken}}"}],"body":{"mode":"raw","raw":"{\"query\":\"mutation($input: EditarConsultaInput!) { editarConsulta(input: $input) { id status reason } }\",\"variables\":{\"input\":{\"id\":\"{{createdConsultaId}}\",\"doctorName\":\"Dra. Teste\",\"dateTime\":\"{{futureDateTime}}\",\"reason\":\"Cancelada no teste\",\"status\":\"CANCELLED\"}}}"},"url":"{{baseUrl}}/graphql"}},
      {"name":"Médico não agenda","event":[{"listen":"test","script":{"exec":["pm.test('FORBIDDEN',()=>pm.expect(pm.response.json().errors[0].extensions.classification).to.eql('FORBIDDEN'));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{medicoToken}}"}],"body":{"mode":"raw","raw":"{\"query\":\"mutation { agendarConsulta(input:{patientId:1,doctorName:\\\"D\\\",dateTime:\\\"{{futureDateTime}}\\\",reason:\\\"R\\\"}) { id } }\"}"},"url":"{{baseUrl}}/graphql"}},
      {"name":"Enfermeiro não edita","event":[{"listen":"test","script":{"exec":["pm.test('FORBIDDEN',()=>pm.expect(pm.response.json().errors[0].extensions.classification).to.eql('FORBIDDEN'));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{enfermeiroToken}}"}],"body":{"mode":"raw","raw":"{\"query\":\"mutation { editarConsulta(input:{id:1,doctorName:\\\"D\\\",dateTime:\\\"{{futureDateTime}}\\\",reason:\\\"R\\\",status:\\\"SCHEDULED\\\"}) { id } }\"}"},"url":"{{baseUrl}}/graphql"}},
      {"name":"Data inválida","event":[{"listen":"test","script":{"exec":["pm.test('BAD_REQUEST',()=>pm.expect(pm.response.json().errors[0].extensions.classification).to.eql('BAD_REQUEST'));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{enfermeiroToken}}"}],"body":{"mode":"raw","raw":"{\"query\":\"mutation { agendarConsulta(input:{patientId:1,doctorName:\\\"D\\\",dateTime:\\\"inválida\\\",reason:\\\"R\\\"}) { id } }\"}"},"url":"{{baseUrl}}/graphql"}},
      {"name":"Paciente inexistente","event":[{"listen":"test","script":{"exec":["pm.test('BAD_REQUEST',()=>pm.expect(pm.response.json().errors[0].extensions.classification).to.eql('BAD_REQUEST'));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{enfermeiroToken}}"}],"body":{"mode":"raw","raw":"{\"query\":\"mutation { agendarConsulta(input:{patientId:999,doctorName:\\\"D\\\",dateTime:\\\"{{futureDateTime}}\\\",reason:\\\"R\\\"}) { id } }\"}"},"url":"{{baseUrl}}/graphql"}}
    ]},
    {"name":"05 - Segurança e limpeza","item":[
      {"name":"Sem token","event":[{"listen":"test","script":{"exec":["pm.test('401',()=>pm.response.to.have.status(401));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"query\":\"query { patient(id:1) { id } }\"}"},"url":"{{baseUrl}}/graphql"}},
      {"name":"Token inválido","event":[{"listen":"test","script":{"exec":["pm.test('401',()=>pm.response.to.have.status(401));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer inválido"}],"body":{"mode":"raw","raw":"{\"query\":\"query { patient(id:1) { id } }\"}"},"url":"{{baseUrl}}/graphql"}},
      {"name":"Remover usuário criado","event":[{"listen":"test","script":{"exec":["pm.test('204',()=>pm.response.to.have.status(204));"]}}],"request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"}],"url":"{{baseUrl}}/users/{{createdUserId}}"}}
    ]}
  ]
}
